# Set a NEW key via the CLI or here; never reuse the removed notebook key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=atlaslex
USE_QUERY_REWRITE=true
DENSE_TOP_K=10
SPARSE_TOP_K=10
FINAL_TOP_K=3
# Heuristic relevance cutoff, not a calibrated probability of correctness.
MIN_RERANK_SCORE=0.1
# Optional absolute project data location (defaults to this checkout).
# ATLASLEX_HOME=/absolute/path/to/atlaslex
